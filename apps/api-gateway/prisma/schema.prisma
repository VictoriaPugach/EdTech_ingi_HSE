// =============================================================================
//  Prisma schema — BC-3 Learning Management
//  Полная ER-диаграмма из System Design §1.4 (рис. 6, справа).
//  Миграции: `npx prisma migrate dev --name <name>` (запускать в контейнере).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Пользователи и роли
// ----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(STUDENT)
  ageYears     Int?      @map("age_years")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownedSessions     Session[]      @relation("SessionOwner")
  participations    Participant[]
  errorEvents       ErrorEvent[]
  achievements      Achievement[]

  @@map("users")
}

// ----------------------------------------------------------------------------
// Сессии совместного редактирования (BC-1 + BC-3)
// ----------------------------------------------------------------------------

enum SessionLanguage {
  PYTHON
  JAVASCRIPT
}

model Session {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  title       String
  language    SessionLanguage @default(PYTHON)
  inviteCode  String          @unique @map("invite_code")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  closedAt    DateTime?       @map("closed_at")

  owner        User          @relation("SessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants Participant[]
  snapshots    Snapshot[]
  errorEvents  ErrorEvent[]

  @@index([ownerId])
  @@index([inviteCode])
  @@map("sessions")
}

model Participant {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("participants")
}

// ----------------------------------------------------------------------------
// Снапшоты CRDT-документа (BC-1, ФТ-5: история изменений / откат)
// ----------------------------------------------------------------------------

model Snapshot {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  // Бинарный Yjs-state (Y.encodeStateAsUpdate). Восстанавливается через Y.applyUpdate.
  state      Bytes
  // Текстовое представление для предпросмотра в UI (необязательно).
  preview    String?
  opCount    Int      @map("op_count")
  createdAt  DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("snapshots")
}

// ----------------------------------------------------------------------------
// События ошибок (BC-2 + BC-3, для аналитики и Hint Personalizer)
// ----------------------------------------------------------------------------

model ErrorEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.Uuid
  errorType  String   @map("error_type")
  language   String
  // Координаты ошибки в коде
  line       Int?
  column     Int?
  // Был ли запрошен hint и был ли он полезен (ставится из UI)
  hintShown  Boolean  @default(false) @map("hint_shown")
  hintHelpful Boolean? @map("hint_helpful")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([errorType])
  @@map("error_events")
}

// ----------------------------------------------------------------------------
// Геймификация (ФТ-14)
// ----------------------------------------------------------------------------

model Achievement {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Код достижения (например "first_fix", "streak_5", "helpful_peer").
  code      String
  earnedAt  DateTime @default(now()) @map("earned_at")
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@map("achievements")
}
