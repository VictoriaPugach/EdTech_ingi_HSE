{
  "name": "@edtech/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web SPA: React + Vite + CodeMirror 6 + Yjs.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
