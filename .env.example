# ============================================================================
#  Educational Platform for Collaborative Programming
#  Пример переменных окружения. Скопируй в .env и подставь свои значения.
#  Файл .env в git НЕ коммитится (см. .gitignore).
# ============================================================================

# --- Общее ---
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL (BC-3 LMS, BC-1 snapshots) ---
POSTGRES_USER=edtech
POSTGRES_PASSWORD=edtech_dev_password
POSTGRES_DB=edtech
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma DATABASE_URL — собирается из переменных выше
DATABASE_URL=postgresql://edtech:edtech_dev_password@postgres:5432/edtech?schema=public

# --- Redis (BC-1 Pub/Sub для CRDT-broadcast между нодами) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- API Gateway (BC-3) ---
GATEWAY_PORT=4000
JWT_SECRET=change-me-in-production-use-32-bytes-of-randomness
JWT_ACCESS_TTL=24h

# --- Realtime Sync (BC-1, WebSocket) ---
REALTIME_PORT=4001
REALTIME_WS_PATH=/ws

# --- Hint Service (BC-2) ---
HINT_SERVICE_PORT=4002
HINT_SERVICE_URL=http://hint-service:4002

# --- LLM (опционально, для будущих итераций; в MVP работает по шаблонам) ---
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER_ID=
# OPENAI_API_KEY=

# --- Web SPA (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4001/ws
