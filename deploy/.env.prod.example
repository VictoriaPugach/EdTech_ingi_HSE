# =============================================================================
#  Прод-конфигурация тестового сервера. Скопируйте в deploy/.env.prod и заполните.
#  НЕ коммитьте .env.prod в git (там секреты).
#
#    cp deploy/.env.prod.example deploy/.env.prod
# =============================================================================

# --- Домен (A-запись DNS должна указывать на IP сервера) ---
DOMAIN=edtech.example.ru
ACME_EMAIL=you@example.ru          # email для Let's Encrypt (уведомления)

# Публичные URL приложения (вшиваются в web-бандл при сборке).
# Должны совпадать с DOMAIN. При смене домена пересоберите web (up --build).
PUBLIC_URL=https://edtech.example.ru
PUBLIC_WS_URL=wss://edtech.example.ru/ws

# --- Секреты (ОБЯЗАТЕЛЬНО заменить на свои!) ---
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=ЗАМЕНИТЕ_НА_32_БАЙТА_СЛУЧАЙНОСТИ
JWT_ACCESS_TTL=24h

# --- PostgreSQL ---
POSTGRES_USER=edtech
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=edtech

# --- Видео: LiveKit ---
# Рекомендуется LiveKit Cloud (cloud.livekit.io): создайте проект и возьмите
# URL вида wss://<project>.livekit.cloud + API Key/Secret. Тогда не нужно
# открывать UDP-порты и настраивать TURN — медиа берёт на себя LiveKit.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=ЗАМЕНИТЕ_НА_СЕКРЕТ_LIVEKIT
